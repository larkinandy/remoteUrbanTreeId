# ignore adobe illustrator files
*.ai

# ignore files containing secrets
*.env

# ignore compiled python scripts
*.pyc

# ignore Windows command scripts
*.cmd

# ignore dot-prefixed directories at any depth
.*/

# local archive of superseded development and diagnostic scripts
/.private_archive/

# ignore local/generated data collection files
/dataCollection/**
/dataCollectionPreprocessing/LiDAR/*.csv
/dataCollectionPreprocessing/LiDAR/*.json
/dataCollectionPreprocessing/LiDAR/**/*.csv
/dataCollectionPreprocessing/LiDAR/**/*.json

# Frozen LiDAR configurations, inputs, and summaries are reproducibility artifacts.
!/dataCollectionPreprocessing/LiDAR/provenance/
!/dataCollectionPreprocessing/LiDAR/provenance/**

/dataCollectionPreprocessing/NAIP/*.csv
/dataCollectionPreprocessing/NAIP/*.json
/dataCollectionPreprocessing/NAIP/**/*.csv
/dataCollectionPreprocessing/NAIP/**/*.json

# Frozen NAIP configurations, inputs, and summaries are reproducibility artifacts.
!/dataCollectionPreprocessing/NAIP/provenance/
!/dataCollectionPreprocessing/NAIP/provenance/**

/dataCollectionPreprocessing/PRISM/*.csv
/dataCollectionPreprocessing/PRISM/*.json
/dataCollectionPreprocessing/PRISM/**/*.csv
/dataCollectionPreprocessing/PRISM/**/*.json
!/dataCollectionPreprocessing/PRISM/provenance/
!/dataCollectionPreprocessing/PRISM/provenance/**

/dataCollectionPreprocessing/Sentinel2/*.csv
/dataCollectionPreprocessing/Sentinel2/*.json
/dataCollectionPreprocessing/Sentinel2/**/*.csv
/dataCollectionPreprocessing/Sentinel2/**/*.json
!/dataCollectionPreprocessing/Sentinel2/provenance/
!/dataCollectionPreprocessing/Sentinel2/provenance/**

/dataCollectionPreprocessing/Shard/*.csv
/dataCollectionPreprocessing/Shard/*.json
/dataCollectionPreprocessing/Shard/**/*.csv
/dataCollectionPreprocessing/Shard/**/*.json
!/dataCollectionPreprocessing/Shard/provenance/
!/dataCollectionPreprocessing/Shard/provenance/**

/dataCollectionPreprocessing/satelliteEmbeddings/*.csv
/dataCollectionPreprocessing/satelliteEmbeddings/*.json
/dataCollectionPreprocessing/satelliteEmbeddings/*.jsonl
/dataCollectionPreprocessing/satelliteEmbeddings/**/*.csv
/dataCollectionPreprocessing/satelliteEmbeddings/**/*.json
/dataCollectionPreprocessing/satelliteEmbeddings/**/*.jsonl
!/dataCollectionPreprocessing/satelliteEmbeddings/provenance/
!/dataCollectionPreprocessing/satelliteEmbeddings/provenance/**

/dataCollectionPreprocessing/treeCrown/*.csv
/dataCollectionPreprocessing/treeCrown/*.json
/dataCollectionPreprocessing/treeCrown/**/*.csv
/dataCollectionPreprocessing/treeCrown/**/*.json
!/dataCollectionPreprocessing/treeCrown/provenance/
