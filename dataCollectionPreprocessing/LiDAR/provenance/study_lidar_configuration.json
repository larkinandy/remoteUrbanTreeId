{
  "schema_version": 1,
  "purpose": "Frozen parameter values used to construct the study LiDAR inputs.",
  "environments": {
    "upstream_gis_preprocessing": {
      "software": "ArcGIS Pro",
      "version": "3.6",
      "python_environment": "arcgispro-py3",
      "notes": "ArcPy is licensed software distributed with ArcGIS Pro and is not installed by environment.yml."
    },
    "lidar_tile_binning_and_derivation": {
      "implementation": "create_tree_centered_lidar_crop_products_laspy_pipeline.py",
      "requirements": ["numpy", "laspy", "lazrs", "pyproj"],
      "notes": "The retained final CHM products were generated by the laspy-first pipeline rather than ArcPy rasterization."
    }
  },
  "manifest_selection": {
    "project_selection": "best",
    "project_coverage_tie_fraction": 1.0,
    "event_project_keywords": ["flood", "wildfire", "hurricane", "storm", "sandy"],
    "allow_event_projects": false,
    "min_non_event_coverage": 0.9,
    "min_project_year": 2012,
    "preferred_project_year": 2017,
    "min_preferred_coverage": 0.85,
    "allow_stale_projects": false,
    "bbox_buffer_metres": 500.0,
    "sentinel_cell_size_metres": 10.0,
    "sentinel_origin_x": 0.0,
    "sentinel_origin_y": 0.0,
    "chip_half_size_metres": 10.0,
    "coverage_margin_metres": 15.0,
    "max_coverage_points_per_city": 5000,
    "include_bbox_only": false
  },
  "tree_centered_products": {
    "stage": "all",
    "metadata_pattern": "*_tree_id_centered_nearest_64px_metadata.csv",
    "crop_width_metres": 38.0,
    "pixel_size_metres": 1.0,
    "pixels_per_side": 38,
    "auto_z_scale": true,
    "z_scale_audit_tiles": 3,
    "dtm_class_codes": [2],
    "dsm_class_codes": [1, 2, 3, 4, 5, 6, 9, 17],
    "checkpoint_every_tiles": 1,
    "auto_accept_coverage": 0.75,
    "preference_penalty": 0.1,
    "allow_empty_products": false
  },
  "structure_sidecars": {
    "metadata_pattern": "*_tree_id_centered_nearest_64px_metadata.csv",
    "crop_pattern": "*_tree_id_centered_nearest_64px_rgbnir_crops.npy",
    "chm_pattern": "*_tree_id_centered_nearest_64px_chm.npy",
    "lidar_index_pattern": "*_tree_id_centered_nearest_64px_lidar_index.csv",
    "center_fraction": 0.5,
    "vegetation_ndvi_threshold": 0.2,
    "tree_ndvi_threshold": 0.2,
    "tree_height_threshold_metres": 2.0,
    "component_mode": "fast"
  },
  "frozen_provenance": {
    "tile_manifest": "provenance/frozen_study_lidar_tile_manifest.csv",
    "tile_manifest_sha256": "814e4dd9dd89840ce8a227f692118142c38e361599bf321ca73b20043cd36f47",
    "city_summary": "provenance/frozen_study_lidar_city_summary.csv",
    "city_summary_sha256": "1598f325a52449885a343d93da2b5d1d8cd249ff0f7a80a81ea8f3e81a2afd71",
    "project_table": "provenance/frozen_study_lidar_project_table.csv",
    "project_table_sha256": "29be49b14f84e4937a286d92ceb7b58fb4e18dd84f56cb43f8f627fc1776f8ff",
    "reconstruction_note": "The mutable download-management manifest was not retained. These frozen tables were reconstructed from completed bin-state files and final CHM indexes, which identify the exact tiles and projects used by the study."
  }
}
