{
  "schema_version": 1,
  "partition": "config/final_k11_partition.npz",
  "collapse": "config/final_k11_to_k6_collapse.npz",
  "seed": 13,
  "epochs": 120,
  "early_stopping_patience": 12,
  "early_stopping_min_delta": 0.0001,
  "checkpoint_selection_score": "blended",
  "blended_score_weights": {
    "macro_f1": 0.5,
    "accuracy": 0.3,
    "weighted_f1": 0.2
  },
  "save_top_k_checkpoints": 5,
  "batch_size": 1024,
  "hidden_dim": 128,
  "dropout": 0.2,
  "learning_rate": 0.0005,
  "weight_decay": 0.0001,
  "gradient_clip": 2.0,
  "class_weighting": "sqrt_inverse",
  "class_weight_max": 3.0,
  "image_center_crop_pixels": 28,
  "raster_normalization": "group",
  "use_naip_chm_interaction_branch": true,
  "interaction_fusion_mode": "learned_common_grid",
  "independent_chm_full_extent": true,
  "interaction_naip_full_extent": false,
  "interaction_naip_crop_pixels": 30,
  "interaction_naip_patch_pixels": 5,
  "interaction_chm_patch_pixels": 3,
  "excluded_modalities": ["tree_centered_structure"],
  "feature_stat_samples": 20000,
  "shard_window_size": 8
}
