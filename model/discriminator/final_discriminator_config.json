{
  "schema_version": 1,
  "description": "Frozen manuscript discriminator configuration. Supply machine-specific complete_shard_root and output_dir on the command line.",
  "training_arguments": {
    "run_name": "final_groupnorm_interaction_discriminator",
    "label_mode": "scientific_binomial_or_genus",
    "min_class_train_samples": 500,
    "val_fraction": 0.15,
    "test_fraction": 0.15,
    "max_val_samples": 150000,
    "max_test_samples": 150000,
    "exclude_qa_from_model": true,
    "use_sentinel_phenology": true,
    "use_raw_sentinel": true,
    "use_satellite_embedding": true,
    "use_prism_normals": false,
    "epochs": 120,
    "batch_size": 768,
    "num_workers": 2,
    "eval_num_workers": 0,
    "prefetch_factor": 3,
    "shard_window_size": 8,
    "max_shard_cache": 12,
    "learning_rate": 0.0005,
    "weight_decay": 0.0001,
    "hidden_dim": 128,
    "embedding_dim": 64,
    "dropout": 0.2,
    "temperature": 0.12,
    "classification_loss_weight": 0.35,
    "class_weighting": "sqrt_inverse",
    "class_weight_max": 3.0,
    "image_center_crop_pixels": 32,
    "naip_encoder_normalization": "group",
    "chm_encoder_normalization": "group",
    "use_naip_chm_interaction_branch": true,
    "interaction_encoder_normalization": "group",
    "interaction_naip_patch_pixels": 5,
    "interaction_chm_patch_pixels": 3,
    "early_stopping_patience": 12,
    "early_stopping_min_delta": 0.0005,
    "seed": 42,
    "export_validation_embeddings": true,
    "evaluate_test": false
  }
}
